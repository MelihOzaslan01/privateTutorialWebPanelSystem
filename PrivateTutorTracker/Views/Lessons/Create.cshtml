@model PrivateTutorTracker.Models.Lesson

@{
    ViewData["Title"] = "Yeni Ders Ekle";
}

<style>
    .form-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        border: none;
    }
    .form-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border: none;
    }
    .form-header h3 {
        margin: 0;
        font-weight: 700;
        font-size: 1.75rem;
    }
    .form-header p {
        margin: 0.5rem 0 0;
        opacity: 0.95;
        font-size: 0.95rem;
    }
    .form-body {
        padding: 2.5rem;
    }
    .form-label {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }
    .form-control, .form-select {
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }
    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    .input-group-text {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        font-weight: 600;
        border-radius: 0 12px 12px 0;
        padding: 0.75rem 1rem;
    }
    .input-group .form-control {
        border-radius: 12px 0 0 12px;
    }
    .form-section {
        background: #f8fafc;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 2px solid #e2e8f0;
    }
    .form-section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #667eea;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        padding: 0.875rem 2rem;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }
    .btn-secondary {
        background: white;
        color: #667eea;
        border: 2px solid #e2e8f0;
        padding: 0.875rem 2rem;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    .btn-secondary:hover {
        background: #f8fafc;
        border-color: #667eea;
        color: #667eea;
        transform: translateY(-2px);
    }
    .form-check-input:checked {
        background-color: #667eea;
        border-color: #667eea;
    }
    .alert-warning {
        background: #fff7ed;
        border: 2px solid #fed7aa;
        border-radius: 12px;
        padding: 1.25rem;
    }
    .text-muted {
        color: #64748b !important;
        font-size: 0.875rem;
    }
    .required-star {
        color: #ef4444;
        font-weight: 700;
    }
    .time-display {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        font-weight: 600;
        text-align: center;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card form-card">
            <div class="card-header form-header">
                <h3>
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-plus-circle me-2" viewBox="0 0 16 16" style="vertical-align: middle;">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                    </svg>
                    Yeni Ders Ekle
                </h3>
                <p>Öğrenciniz için yeni bir ders planı oluşturun</p>
            </div>
            <div class="card-body form-body">
                <form asp-action="Create">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3 mb-4">
                            <h6 class="fw-bold mb-2">⚠️ Form Hataları:</h6>
                            @foreach (var modelState in ViewData.ModelState)
                            {
                                @if (modelState.Value.Errors.Any())
                                {
                                    <ul class="mb-0">
                                        @foreach (var error in modelState.Value.Errors)
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    </ul>
                                }
                            }
                        </div>
                    }

                    <!-- Şablon Seçimi -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-layers" viewBox="0 0 16 16">
                                <path d="M8.235 1.559a.5.5 0 0 0-.47 0l-7.5 4a.5.5 0 0 0 0 .882L3.188 8 .264 9.559a.5.5 0 0 0 0 .882l7.5 4a.5.5 0 0 0 .47 0l7.5-4a.5.5 0 0 0 0-.882L12.813 8l2.922-1.559a.5.5 0 0 0 0-.882l-7.5-4z"/>
                            </svg>
                            Hızlı Şablon Seçimi (Opsiyonel)
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Ders Şablonu</label>
                            <select id="templateSelect" class="form-select">
                                <option value="">Şablondan seç veya manuel gir...</option>
                            </select>
                            <small class="text-muted">Sık kullanılan ders bilgilerini otomatik doldurmak için şablon seçin.</small>
                        </div>
                    </div>

                    <!-- Öğrenci Seçimi -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                            </svg>
                            Öğrenci Bilgisi
                        </div>
                        <div class="mb-0">
                            <label asp-for="StudentId" class="form-label">Öğrenci <span class="required-star">*</span></label>
                            @if (ViewBag.StudentId != null && ((IEnumerable<SelectListItem>)ViewBag.StudentId).Any())
                            {
                                <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId">
                                    <option value="0">Bir öğrenci seçin...</option>
                                </select>
                                <span asp-validation-for="StudentId" class="text-danger"></span>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <strong>⚠️ Henüz hiç öğrenci eklenmemiş!</strong>
                                    <p class="mb-0">Ders eklemeden önce en az bir öğrenci eklemelisiniz.</p>
                                    <a asp-controller="Students" asp-action="Create" class="btn btn-sm btn-primary mt-2">
                                        + Yeni Öğrenci Ekle
                                    </a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Tarih ve Saat -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-calendar-event" viewBox="0 0 16 16">
                                <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                                <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                            </svg>
                            Tarih ve Saat Bilgileri
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Tarih</label>
                                <input type="date" class="form-control" id="tarihInput" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Başlangıç Saati</label>
                                <input type="time" class="form-control" id="saatInput" />
                                <small class="text-muted">Saat seçin</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Bitiş Saati</label>
                                <input type="text" class="form-control time-display" id="bitisSaatInput" readonly />
                            </div>
                        </div>

                        <input asp-for="Baslangic" type="hidden" id="baslangicInput" />
                        <input asp-for="Bitis" type="hidden" id="bitisInput" />

                        <div class="mb-0">
                            <label for="dersSayisi" class="form-label">Ders Sayısı</label>
                            <select id="dersSayisi" name="DersSayisi" class="form-select">
                                <option value="1" selected>1 Ders (40 dakika)</option>
                                <option value="2">2 Ders (1 saat 35 dakika - 15 dk mola)</option>
                                <option value="3">3 Ders (2 saat 30 dakika - 15 dk molalar)</option>
                                <option value="4">4 Ders (3 saat 25 dakika - 15 dk molalar)</option>
                            </select>
                            <small class="text-muted">Her ders 40 dakika, aralarında 15 dakika mola vardır.</small>
                        </div>
                    </div>

                    <!-- Tekrarlı Ders Seçenekleri -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-arrow-repeat" viewBox="0 0 16 16">
                                <path d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.966 2.36a.25.25 0 0 1-.384 0l-1.966-2.36a.25.25 0 0 1 .192-.41zm-11 2h3.932a.25.25 0 0 0 .192-.41L2.692 6.23a.25.25 0 0 0-.384 0L.342 8.59A.25.25 0 0 0 .534 9z"/>
                                <path fill-rule="evenodd" d="M8 3c-1.552 0-2.94.707-3.857 1.818a.5.5 0 1 1-.771-.636A6.002 6.002 0 0 1 13.917 7H12.9A5.002 5.002 0 0 0 8 3zM3.1 9a5.002 5.002 0 0 0 8.757 2.182.5.5 0 1 1 .771.636A6.002 6.002 0 0 1 2.083 9H3.1z"/>
                            </svg>
                            Tekrarlı Ders Planlama (Opsiyonel)
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="tekrarliDersCheck" style="width: 20px; height: 20px; margin-top: 2px;">
                            <label class="form-check-label" for="tekrarliDersCheck" style="margin-left: 8px; font-weight: 600;">
                                Bu dersi tekrarlı olarak planla
                            </label>
                            <small class="d-block text-muted mt-1 ms-4">Aynı öğrenci için belirli aralıklarla otomatik ders oluştur.</small>
                        </div>

                        <div id="tekrarliDersOptions" style="display: none;">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="tekrarPeriyodu" class="form-label">Tekrar Periyodu</label>
                                    <select id="tekrarPeriyodu" name="TekrarPeriyodu" class="form-select">
                                        <option value="">Seçiniz...</option>
                                        <option value="Günlük">Her Gün</option>
                                        <option value="Haftalık">Her Hafta (7 gün)</option>
                                        <option value="İkiHaftadaBir">İki Haftada Bir (14 gün)</option>
                                    </select>
                                    <small class="text-muted">Dersler ne sıklıkla tekrar edecek?</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="tekrarSayisi" class="form-label">Tekrar Sayısı</label>
                                    <input type="number" id="tekrarSayisi" name="TekrarSayisi" class="form-control" min="2" max="20" value="4" />
                                    <small class="text-muted">Kaç ders oluşturulsun? (2-20 arası)</small>
                                </div>
                            </div>

                            <div class="alert alert-info">
                                <strong>ℹ️ Bilgi:</strong>
                                <p class="mb-0" id="tekrarBilgi">Toplam <strong id="toplamDers">4</strong> ders oluşturulacak. Tüm dersler Google Takvim'e eklenecektir.</p>
                            </div>
                        </div>

                        <input type="hidden" id="tekrarliMi" name="TekrarliMi" value="false" />
                    </div>

                    <!-- Ders Detayları -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-journal-text" viewBox="0 0 16 16">
                                <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                                <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2z"/>
                                <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1z"/>
                            </svg>
                            Ders Detayları
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ders Türü</label>
                            <div class="alert alert-info mb-0" style="background: linear-gradient(135deg, rgba(13, 202, 240, 0.1) 0%, rgba(102, 126, 234, 0.1) 100%); border: 2px solid #0dcaf0; border-radius: 12px;">
                                <div class="d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-camera-video-fill me-3" viewBox="0 0 16 16" style="color: #0dcaf0;">
                                        <path fill-rule="evenodd" d="M0 5a2 2 0 0 1 2-2h7.5a2 2 0 0 1 1.983 1.738l3.11-1.382A1 1 0 0 1 16 4.269v7.462a1 1 0 0 1-1.406.913l-3.111-1.382A2 2 0 0 1 9.5 13H2a2 2 0 0 1-2-2V5z"/>
                                    </svg>
                                    <div>
                                        <strong style="color: #0dcaf0; font-size: 1.1rem;">Online Ders</strong>
                                        <p class="mb-0 mt-1" style="color: #495057;">Tüm dersler online olarak gerçekleştirilmektedir.</p>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" asp-for="Tur" value="0" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Konu" class="form-label">Ders Konusu</label>
                            <input asp-for="Konu" class="form-control" placeholder="Örn: Python Temelleri, Algoritma Mantığı" />
                            <span asp-validation-for="Konu" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Ucret" class="form-label">Ders Ücreti</label>
                                <select asp-for="Ucret" class="form-select">
                                    <option value="450">450 ₺</option>
                                    <option value="500">500 ₺</option>
                                    <option value="550">550 ₺</option>
                                    <option value="600">600 ₺</option>
                                    <option value="650">650 ₺</option>
                                    <option value="700">700 ₺</option>
                                    <option value="750">750 ₺</option>
                                </select>
                                <span asp-validation-for="Ucret" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Durum" class="form-label">Durum</label>
                                <select asp-for="Durum" class="form-select">
                                    <option value="Planlı">📅 Planlı</option>
                                    <option value="Tamamlandı">✅ Tamamlandı</option>
                                    <option value="İptal">❌ İptal</option>
                                </select>
                                <span asp-validation-for="Durum" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Not" class="form-label">Notlar (Öğrenci Görebilir)</label>
                            <textarea asp-for="Not" class="form-control" rows="2" placeholder="Ders hakkında genel notlar..."></textarea>
                            <span asp-validation-for="Not" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DersNotu" class="form-label">Ders Notu (Özel - Sadece Sizin İçin)</label>
                            <textarea asp-for="DersNotu" class="form-control" rows="3" placeholder="Ders sırasında aldığınız özel notlar, öğrenci performansı, önemli hatırlatmalar..."></textarea>
                            <span asp-validation-for="DersNotu" class="text-danger"></span>
                            <small class="text-muted">Bu notlar sadece size özeldir ve başkaları tarafından görülemez.</small>
                        </div>

                        <div class="form-check mb-0">
                            <input asp-for="OdemeAlindi" class="form-check-input" style="width: 20px; height: 20px; margin-top: 2px;" />
                            <label asp-for="OdemeAlindi" class="form-check-label" style="margin-left: 8px; font-weight: 600;">Ödeme Alındı</label>
                        </div>
                    </div>

                    <div class="d-flex gap-3 justify-content-end">
                        <a asp-action="Index" class="btn btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle me-1" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                            </svg>
                            İptal
                        </a>
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-circle me-1" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                            </svg>
                            Dersi Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Şablon yükleme
        (async function loadTemplates() {
            try {
                const response = await fetch('/LessonTemplates/Index');
                const html = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');

                // Alternatif: API endpoint kullan
                const apiResponse = await fetch('@Url.Action("Index", "LessonTemplates")');

                // Şimdilik basit bir yöntem: tüm şablonları yükle
                const templateSelect = document.getElementById('templateSelect');

                // Örnek şablonlar (gerçek data için API endpoint ekleyin)
                @if (ViewBag.Templates != null) {
                    @foreach (var template in (IEnumerable<PrivateTutorTracker.Models.LessonTemplate>)ViewBag.Templates) {
                        <text>
                        const option@(template.Id) = document.createElement('option');
                        option@(template.Id).value = '@template.Id';
                        option@(template.Id).textContent = '@template.Ad';
                        templateSelect.appendChild(option@(template.Id));
                        </text>
                    }
                }
            } catch (error) {
                console.error('Şablonlar yüklenirken hata:', error);
            }
        })();

        // Şablon seçimi değiştiğinde
        document.getElementById('templateSelect')?.addEventListener('change', async function(e) {
            const templateId = e.target.value;
            if (!templateId) return;

            try {
                const response = await fetch(`/LessonTemplates/GetTemplate?id=${templateId}`);
                const template = await response.json();

                // Form alanlarını doldur
                document.querySelector('[name="Konu"]').value = template.konu || '';
                const feeSelect = document.querySelector('[name="Ucret"]');
                const templateFee = String(template.ucret || 450);
                feeSelect.value = Array.from(feeSelect.options).some(option => option.value === templateFee)
                    ? templateFee
                    : '450';
                document.querySelector('[name="Not"]').value = template.not || '';

                // Süreyi hesapla ve bitiş saatini güncelle
                const sure = template.sure || 40;
                const dersSayisiMap = {
                    40: 1,
                    55: 1,
                    95: 2,
                    150: 3,
                    205: 4
                };
                const dersSayisi = Math.ceil(sure / 40);
                document.getElementById('dersSayisi').value = dersSayisi;

                calculateTimes(); // Zamanları yeniden hesapla
            } catch (error) {
                console.error('Şablon yüklenirken hata:', error);
                alert('Şablon yüklenirken bir hata oluştu.');
            }
        });

        // Tekrarlı ders seçeneklerini yönet
        (function() {
            const tekrarliDersCheck = document.getElementById('tekrarliDersCheck');
            const tekrarliDersOptions = document.getElementById('tekrarliDersOptions');
            const tekrarliMiHidden = document.getElementById('tekrarliMi');
            const tekrarSayisiInput = document.getElementById('tekrarSayisi');
            const toplamDersSpan = document.getElementById('toplamDers');

            tekrarliDersCheck.addEventListener('change', function() {
                if (this.checked) {
                    tekrarliDersOptions.style.display = 'block';
                    tekrarliMiHidden.value = 'true';
                } else {
                    tekrarliDersOptions.style.display = 'none';
                    tekrarliMiHidden.value = 'false';
                }
            });

            tekrarSayisiInput.addEventListener('input', function() {
                toplamDersSpan.textContent = this.value;
            });
        })();

        (function() {
            var tarihInput = document.getElementById('tarihInput');
            var saatInput = document.getElementById('saatInput');
            var bitisSaatInput = document.getElementById('bitisSaatInput');
            var baslangicInput = document.getElementById('baslangicInput');
            var bitisInput = document.getElementById('bitisInput');
            var dersSayisiSelect = document.getElementById('dersSayisi');

            // Bugünün tarihini varsayılan olarak ayarla
            var today = new Date();
            tarihInput.value = today.toISOString().split('T')[0];
            saatInput.value = '19:00';

            function calculateTimes() {
                var tarih = tarihInput.value;
                var saat = saatInput.value;
                var dersSayisi = parseInt(dersSayisiSelect.value);

                if (!tarih || !saat) return;

                var baslangicDateTime = tarih + 'T' + saat;
                baslangicInput.value = baslangicDateTime;

                var start = new Date(baslangicDateTime);
                var totalMinutes = dersSayisi * 40 + (dersSayisi - 1) * 15;
                var end = new Date(start.getTime() + totalMinutes * 60000);

                var bitisHours = String(end.getHours()).padStart(2, '0');
                var bitisMinutes = String(end.getMinutes()).padStart(2, '0');
                bitisSaatInput.value = bitisHours + ':' + bitisMinutes;

                var bitisYear = end.getFullYear();
                var bitisMonth = String(end.getMonth() + 1).padStart(2, '0');
                var bitisDay = String(end.getDate()).padStart(2, '0');
                bitisInput.value = bitisYear + '-' + bitisMonth + '-' + bitisDay + 'T' + bitisHours + ':' + bitisMinutes;
            }

            tarihInput.addEventListener('change', calculateTimes);
            saatInput.addEventListener('change', calculateTimes);
            dersSayisiSelect.addEventListener('change', calculateTimes);

            calculateTimes();
        })();

        // Form submit event'ini dinle
        document.querySelector('form').addEventListener('submit', async function(e) {
            // BASİT KONTROL - çakışma kontrolü devre dışı (geçici)
            var studentSelect = document.querySelector('[name="StudentId"]');
            if (!studentSelect || studentSelect.value === '0') {
                e.preventDefault();
                alert('Lütfen bir öğrenci seçin!');
                if (studentSelect) studentSelect.focus();
                return false;
            }

            var baslangicInput = document.getElementById('baslangicInput');
            var bitisInput = document.getElementById('bitisInput');
            if (!baslangicInput || !baslangicInput.value || !bitisInput || !bitisInput.value) {
                e.preventDefault();
                alert('Lütfen tarih ve saat bilgilerini kontrol edin!');
                return false;
            }

            // ÇAKIŞMA KONTROLÜNÜ GEÇİCİ OLARAK DEVRE DIŞI BIRAKTIK
            // Form normal şekilde submit edilecek
            console.log('✅ Form submit ediliyor (çakışma kontrolü yok)...');
        });

        async function validateForm() {
            var studentSelect = document.querySelector('[name="StudentId"]');

            if (!studentSelect || studentSelect.value === '0') {
                alert('Lütfen bir öğrenci seçin!');
                if (studentSelect) studentSelect.focus();
                return false;
            }

            var baslangicInput = document.getElementById('baslangicInput');
            var bitisInput = document.getElementById('bitisInput');

            if (!baslangicInput || !baslangicInput.value || !bitisInput || !bitisInput.value) {
                alert('Lütfen tarih ve saat bilgilerini kontrol edin!');
                return false;
            }

            // Çakışma kontrolü
            var dersSayisi = parseInt(document.getElementById('dersSayisi').value);
            var baslangic = baslangicInput.value;

            try {
                // Anti-forgery token'ı al
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                console.log('Çakışma kontrolü başlatılıyor...', { baslangic, dersSayisi });

                var response = await fetch('/Lessons/CheckConflict', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        Baslangic: baslangic,
                        DersSayisi: dersSayisi
                    })
                });

                console.log('API yanıtı alındı:', response.status, response.statusText);

                if (!response.ok) {
                    console.error('API hatası:', response.status, response.statusText);
                    throw new Error(`API hatası: ${response.status}`);
                }

                var result = await response.json();
                console.log('Çakışma kontrolü sonucu:', result);

                if (result.hasConflict) {
                    var conflictMessage = '⚠️ ÇAKIŞMA TESPİT EDİLDİ!\n\n';
                    conflictMessage += 'Seçtiğiniz saatlerde başka dersler var:\n\n';

                    result.conflicts.forEach(function(conflict, index) {
                        conflictMessage += (index + 1) + '. Çakışma:\n';
                        conflictMessage += '   • Eklemek istediğiniz: ' + conflict.start + ' - ' + conflict.end + '\n';
                        conflictMessage += '   • Mevcut ders: ' + conflict.conflictingStart + ' - ' + conflict.conflictingEnd + '\n';
                        conflictMessage += '   • Öğrenci: ' + conflict.studentName + '\n';
                        conflictMessage += '   • Konu: ' + conflict.subject + '\n\n';
                    });

                    conflictMessage += 'Lütfen farklı bir saat seçin!';
                    alert(conflictMessage);
                    return false;
                }

                return true;
            } catch (error) {
                console.error('Çakışma kontrolünde hata:', error);
                alert('Çakışma kontrolü yapılamadı. Tekrar deneyin.');
                return false;
            }
        }
    </script>
}
