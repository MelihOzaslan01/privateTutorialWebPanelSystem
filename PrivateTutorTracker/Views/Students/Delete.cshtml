@model PrivateTutorTracker.Models.Student

@{
    ViewData["Title"] = "Öğrenciyi Pasif Yap";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card border-warning">
            <div class="card-header bg-warning">
                <h4 class="mb-0">Öğrenciyi Pasif Yap</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <h5>Bu işlemi onaylıyor musunuz?</h5>
                    <p class="mb-0">
                        <strong>@Model.AdSoyad</strong> adlı öğrenci pasif hale getirilecektir.
                        Öğrenci verisi silinmez, sadece pasif olarak işaretlenir.
                    </p>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Ad Soyad:</dt>
                    <dd class="col-sm-8">@Model.AdSoyad</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@(Model.Email ?? "-")</dd>

                    <dt class="col-sm-4">Telefon:</dt>
                    <dd class="col-sm-8">@(Model.Telefon ?? "-")</dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Pasif Yap</button>
                        <a asp-action="Index" class="btn btn-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
