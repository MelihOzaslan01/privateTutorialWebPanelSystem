@model PrivateTutorTracker.Models.Student

@{
    ViewData["Title"] = "Öğrenciyi Kalıcı Olarak Sil";
}

<style>
    .danger-card {
        border: 3px solid #dc3545;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(220, 53, 69, 0.2);
    }
    .danger-header {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        padding: 1.5rem;
        border-radius: 13px 13px 0 0;
    }
    .danger-icon {
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }
    .warning-box {
        background: #fff3cd;
        border-left: 4px solid #ffc107;
        padding: 1rem;
        margin: 1rem 0;
        border-radius: 8px;
    }
    .danger-box {
        background: #f8d7da;
        border-left: 4px solid #dc3545;
        padding: 1rem;
        margin: 1rem 0;
        border-radius: 8px;
    }
    .info-grid {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.5rem 1rem;
        margin: 1rem 0;
    }
    .info-label {
        font-weight: 600;
        color: #495057;
    }
    .stat-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: #e9ecef;
        border-radius: 8px;
        font-weight: 600;
        margin: 0.25rem;
    }
</style>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="danger-card">
            <div class="danger-header text-center">
                <div class="danger-icon mx-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="white" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </svg>
                </div>
                <h3 class="mb-0">KALICI SİLME İŞLEMİ</h3>
                <p class="mb-0 mt-2" style="opacity: 0.9;">Bu işlem geri alınamaz!</p>
            </div>

            <div class="card-body p-4">
                <div class="danger-box">
                    <h5 class="mb-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-shield-fill-exclamation" viewBox="0 0 16 16" style="vertical-align: text-bottom;">
                            <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm-.55 8.502L7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0zM8.002 12a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                        </svg>
                        Kritik Uyarı
                    </h5>
                    <p class="mb-0">
                        <strong>@Model.AdSoyad</strong> adlı öğrenci <strong>kalıcı olarak</strong> silinecektir.
                        Bu işlem <strong class="text-danger">GERİ ALINAMAZ</strong> ve aşağıdaki tüm veriler sistemden tamamen kaldırılacaktır.
                    </p>
                </div>

                <h5 class="mt-4 mb-3">Öğrenci Bilgileri</h5>
                <div class="info-grid">
                    <span class="info-label">Ad Soyad:</span>
                    <span>@Model.AdSoyad</span>

                    <span class="info-label">Email:</span>
                    <span>@(Model.Email ?? "-")</span>

                    <span class="info-label">Telefon:</span>
                    <span>@(Model.Telefon ?? "-")</span>

                    <span class="info-label">Durum:</span>
                    <span>
                        @if (Model.AktifMi)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                    </span>

                    <span class="info-label">Kayıt Tarihi:</span>
                    <span>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                </div>

                <div class="warning-box">
                    <h6 class="mb-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16" style="vertical-align: text-bottom;">
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                        </svg>
                        Silinecek Veriler
                    </h6>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="stat-badge">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-book-fill" viewBox="0 0 16 16">
                                <path d="M8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
                            </svg>
                            @Model.Lessons.Count Ders Kaydı
                        </span>
                        <span class="stat-badge">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-credit-card-fill" viewBox="0 0 16 16">
                                <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1H0V4zm0 3v5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7H0zm3 2h1a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-1a1 1 0 0 1 1-1z"/>
                            </svg>
                            @Model.Payments.Count Ödeme Kaydı
                        </span>
                    </div>
                </div>

                @if (Model.Lessons.Count > 0 || Model.Payments.Count > 0)
                {
                    <div class="alert alert-danger mt-3">
                        <strong>DİKKAT:</strong> Bu öğrenciye ait @Model.Lessons.Count ders ve @Model.Payments.Count ödeme kaydı da <strong>kalıcı olarak silinecektir!</strong>
                        Tüm geçmiş verileriniz kaybolacaktır.
                    </div>
                }

                <div class="mt-4 p-3 bg-light border rounded">
                    <h6 class="mb-2">Alternatif Öneri</h6>
                    <p class="mb-2">
                        Öğrenciyi kalıcı olarak silmek yerine <strong>pasif</strong> olarak işaretlemeyi düşünün.
                        Bu sayede geçmiş kayıtlarınız korunur ve gerektiğinde tekrar aktif hale getirebilirsiniz.
                    </p>
                    @if (Model.AktifMi)
                    {
                        <form asp-controller="Students" asp-action="Delete" method="post" style="display: inline;">
                            <input type="hidden" name="id" value="@Model.Id" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning btn-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash-circle" viewBox="0 0 16 16">
                                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                    <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8z"/>
                                </svg>
                                Öğrenciyi Pasif Yap (Önerilen)
                            </button>
                        </form>
                    }
                </div>

                <hr class="my-4">

                <form asp-action="PermanentDelete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2 justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                            </svg>
                            İptal Et
                        </a>
                        <button type="submit" class="btn btn-danger btn-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                                <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1H2.5zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5zM8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5zm3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0z"/>
                            </svg>
                            Evet, Kalıcı Olarak Sil
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
