@model PrivateTutorTracker.Models.Payment

@{
    ViewData["Title"] = "Yeni Ödeme Ekle";
}

<style>
    .form-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        border: none;
    }
    .form-header {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 2rem;
        border: none;
    }
    .form-header h3 {
        margin: 0;
        font-weight: 700;
        font-size: 1.75rem;
    }
    .form-header p {
        margin: 0.5rem 0 0;
        opacity: 0.95;
        font-size: 0.95rem;
    }
    .form-body {
        padding: 2.5rem;
    }
    .form-label {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }
    .form-control, .form-select {
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }
    .form-control:focus, .form-select:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
    }
    .input-group-text {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        border: none;
        font-weight: 600;
        border-radius: 0 12px 12px 0;
        padding: 0.75rem 1rem;
        font-size: 1.1rem;
    }
    .input-group .form-control {
        border-radius: 12px 0 0 12px;
    }
    .form-section {
        background: #f0fdf4;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 2px solid #d1fae5;
    }
    .form-section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #059669;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .btn-primary {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        padding: 0.875rem 2rem;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
    }
    .btn-secondary {
        background: white;
        color: #059669;
        border: 2px solid #e2e8f0;
        padding: 0.875rem 2rem;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    .btn-secondary:hover {
        background: #f0fdf4;
        border-color: #10b981;
        color: #059669;
        transform: translateY(-2px);
    }
    .text-muted {
        color: #64748b !important;
        font-size: 0.875rem;
    }
    .required-star {
        color: #ef4444;
        font-weight: 700;
    }
    .alert-danger {
        background: #fee;
        border: 2px solid #fca5a5;
        border-radius: 12px;
        padding: 1.25rem;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card form-card">
            <div class="card-header form-header">
                <h3>
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-cash-coin me-2" viewBox="0 0 16 16" style="vertical-align: middle;">
                        <path fill-rule="evenodd" d="M11 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm5-4a5 5 0 1 1-10 0 5 5 0 0 1 10 0z"/>
                        <path d="M9.438 11.944c.047.596.518 1.06 1.363 1.116v.44h.375v-.443c.875-.061 1.386-.529 1.386-1.207 0-.618-.39-.936-1.09-1.1l-.296-.07v-1.2c.376.043.614.248.671.532h.658c-.047-.575-.54-1.024-1.329-1.073V8.5h-.375v.45c-.747.073-1.255.522-1.255 1.158 0 .562.378.92 1.007 1.066l.248.061v1.272c-.384-.058-.639-.27-.696-.563h-.668zm1.36-1.354c-.369-.085-.569-.26-.569-.522 0-.294.216-.514.572-.578v1.1h-.003zm.432.746c.449.104.655.272.655.569 0 .339-.257.571-.709.614v-1.195l.054.012z"/>
                        <path d="M1 0a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h4.083c.058-.344.145-.678.258-1H3a2 2 0 0 0-2-2V3a2 2 0 0 0 2-2h10a2 2 0 0 0 2 2v3.528c.38.34.717.728 1 1.154V1a1 1 0 0 0-1-1H1z"/>
                        <path d="M9.998 5.083 10 5a2 2 0 1 0-3.132 1.65 5.982 5.982 0 0 1 3.13-1.567z"/>
                    </svg>
                    Yeni Ödeme Kaydı Ekle
                </h3>
                <p>Öğrenciden alınan ödemeyi sisteme kaydedin</p>
            </div>
            <div class="card-body form-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- Öğrenci Seçimi -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                            </svg>
                            Öğrenci Bilgisi
                        </div>
                        <div class="mb-0">
                            <label asp-for="StudentId" class="form-label">Öğrenci <span class="required-star">*</span></label>
                            <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId">
                                <option value="0">Bir öğrenci seçin...</option>
                            </select>
                            <span asp-validation-for="StudentId" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Ödeme Bilgileri -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-wallet2" viewBox="0 0 16 16">
                                <path d="M12.136.326A1.5 1.5 0 0 1 14 1.78V3h.5A1.5 1.5 0 0 1 16 4.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 13.5v-9a1.5 1.5 0 0 1 1.432-1.499L12.136.326zM5.562 3H13V1.78a.5.5 0 0 0-.621-.484L5.562 3zM1.5 4a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-13z"/>
                            </svg>
                            Ödeme Detayları
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Tarih" class="form-label">Ödeme Tarihi <span class="required-star">*</span></label>
                                <input asp-for="Tarih" class="form-control" type="date" />
                                <span asp-validation-for="Tarih" class="text-danger"></span>
                                <small class="text-muted">Ödemenin alındığı tarih</small>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Tutar" class="form-label">Tutar <span class="required-star">*</span></label>
                                <div class="input-group">
                                    <input asp-for="Tutar" class="form-control" type="number" step="0.01" placeholder="0.00" />
                                    <span class="input-group-text">₺</span>
                                </div>
                                <span asp-validation-for="Tutar" class="text-danger"></span>
                                <small class="text-muted">Alınan ödeme tutarı</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Donem" class="form-label">Ödeme Dönemi</label>
                            <select asp-for="Donem" class="form-select">
                                <option value="Haftalık">📅 Haftalık</option>
                                <option value="Birikmeli">💰 Birikmeli</option>
                                <option value="Aylık">📆 Aylık</option>
                            </select>
                            <span asp-validation-for="Donem" class="text-danger"></span>
                            <small class="text-muted">Ödemenin hangi dönem için yapıldığını belirtin</small>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Durum" class="form-label">Ödeme Durumu</label>
                            <select asp-for="Durum" class="form-select">
                                <option value="@((int)PrivateTutorTracker.Models.PaymentStatus.Beklemede)">⏳ Beklemede</option>
                                <option value="@((int)PrivateTutorTracker.Models.PaymentStatus.Tamamlandi)">✅ Tamamlandı</option>
                                <option value="@((int)PrivateTutorTracker.Models.PaymentStatus.Gecikti)">⚠️ Gecikti</option>
                            </select>
                            <span asp-validation-for="Durum" class="text-danger"></span>
                            <small class="text-muted">Ödemenin mevcut durumunu seçin</small>
                        </div>
                    </div>

                    <!-- Açıklama -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-chat-left-text" viewBox="0 0 16 16">
                                <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12.793a.5.5 0 0 0 .854.353l2.853-2.853A1 1 0 0 1 4.414 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                                <path d="M3 3.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zM3 6a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 6zm0 2.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                            </svg>
                            Açıklama ve Notlar
                        </div>
                        <div class="mb-0">
                            <label asp-for="Aciklama" class="form-label">Açıklama</label>
                            <textarea asp-for="Aciklama" class="form-control" rows="4"
                                      placeholder="Örn: 15-22 Ocak haftası ödemesi, toplam 4 ders karşılığı"></textarea>
                            <span asp-validation-for="Aciklama" class="text-danger"></span>
                            <small class="text-muted">Ödeme ile ilgili detaylı bilgi girebilirsiniz</small>
                        </div>
                    </div>

                    <div class="d-flex gap-3 justify-content-end">
                        <a asp-action="Index" class="btn btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle me-1" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                            </svg>
                            İptal
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-circle me-1" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                            </svg>
                            Ödemeyi Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Bugünün tarihini varsayılan olarak ayarla
        document.addEventListener('DOMContentLoaded', function() {
            var tarihInput = document.getElementById('Tarih');
            if (tarihInput && !tarihInput.value) {
                var today = new Date();
                tarihInput.value = today.toISOString().split('T')[0];
            }
        });
    </script>
}
