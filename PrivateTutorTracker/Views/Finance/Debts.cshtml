@model IEnumerable<PrivateTutorTracker.Models.Debt>
@{
    ViewData["Title"] = "Borclar";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 fw-bold mb-1">Borclar</h1><p class="text-muted mb-0">Aktif ve pasif borc kayitlari</p></div>
    <a class="btn btn-warning" asp-action="CreateDebt">Yeni borc</a>
</div>
<div class="panel-card card">
    <div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Ad</th><th>Tip</th><th>Kurum/Kisi</th><th>Sonraki Odeme</th><th class="text-end">Aylik</th><th class="text-end">Kalan</th><th>Durum</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr><td class="fw-semibold">@item.Ad</td><td>@item.BorcTipi</td><td>@item.KurumKisi</td><td>@item.SonrakiOdemeTarihi.ToString("dd.MM.yyyy")</td><td class="text-end">@item.AylikTaksit.ToString("N0")₺</td><td class="text-end fw-bold text-warning">@item.KalanTutar.ToString("N0")₺</td><td><span class="badge @(item.AktifMi ? "bg-success" : "bg-secondary")">@(item.AktifMi ? "Aktif" : "Pasif")</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="EditDebt" asp-route-id="@item.Id">Duzenle</a></td></tr>
        }
        </tbody>
    </table></div>
    @if (!Model.Any()) { <div class="card-body text-muted">Borc kaydi bulunamadi.</div> }
</div>
