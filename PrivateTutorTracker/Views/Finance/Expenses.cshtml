@model IEnumerable<PrivateTutorTracker.Models.Expense>
@{
    ViewData["Title"] = "Giderler";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 fw-bold mb-1">Giderler</h1><p class="text-muted mb-0">Finans gider kayitlari</p></div>
    <a class="btn btn-danger" asp-action="CreateExpense">Yeni gider</a>
</div>
<div class="panel-card card">
    <div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Tarih</th><th>Ad</th><th>Kategori</th><th>Odeme</th><th>Aciklama</th><th class="text-end">Tutar</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr><td>@item.Tarih.ToString("dd.MM.yyyy")</td><td class="fw-semibold">@item.Ad</td><td>@item.Kategori</td><td>@item.OdemeYontemi</td><td>@item.Aciklama</td><td class="text-end fw-bold text-danger">@item.Tutar.ToString("N0")₺</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="EditExpense" asp-route-id="@item.Id">Duzenle</a></td></tr>
        }
        </tbody>
    </table></div>
    @if (!Model.Any()) { <div class="card-body text-muted">Gider kaydi bulunamadi.</div> }
</div>
