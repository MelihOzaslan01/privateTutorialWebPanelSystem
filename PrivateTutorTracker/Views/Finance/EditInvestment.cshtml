@model Investment

@{
    ViewData["Title"] = "Yatirim Duzenle";
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <h1 class="h3 fw-bold">Yatirim Duzenle</h1>
        <form asp-action="EditInvestment" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <partial name="_InvestmentFormFields" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-info">Guncelle</button>
                <a asp-action="Investments" class="btn btn-light">Vazgec</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
