@model PrivateTutorTracker.Models.ActivityLog

@{
    ViewData["Title"] = "Aktivite Detayı";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0">Aktivite Detayı</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Tarih</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</dd>
            <dt class="col-sm-3">Kullanıcı</dt>
            <dd class="col-sm-9">@Model.User?.UserName</dd>
            <dt class="col-sm-3">Aksiyon</dt>
            <dd class="col-sm-9">@Model.Action</dd>
            <dt class="col-sm-3">Varlık</dt>
            <dd class="col-sm-9">@Model.EntityType #@Model.EntityId</dd>
            <dt class="col-sm-3">Açıklama</dt>
            <dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">IP</dt>
            <dd class="col-sm-9">@Model.IpAddress</dd>
            <dt class="col-sm-3">Detay</dt>
            <dd class="col-sm-9"><pre class="mb-0 p-3 bg-light border rounded" style="white-space:pre-wrap">@(ViewBag.FormattedDetails ?? "-")</pre></dd>
        </dl>
    </div>
</div>
