                        </svg>
                        Dashboard'u Aç
                    </a>
                </div>
            </div>
        </div>
    </div>

    <h4 class="report-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-download me-2 d-none d-sm-inline" viewBox="0 0 16 16">
            <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
            <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
        </svg>
        Rapor Oluştur <span class="d-none d-sm-inline">(PDF / Excel)</span>
    </h4>

    <div class="row g-3 g-md-4 mb-4">
        <!-- Aylık Ders Raporu -->
        <div class="col-12 col-lg-4">
            <div class="card h-100 report-workspace report-lessons">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-calendar3 me-2" viewBox="0 0 16 16">
                            <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857V3.857z"/>
                        </svg>
                        Aylık Ders Raporu
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Belirli bir aya ait tüm derslerin listesi ve istatistikleri</p>

                    <form id="monthlyReportForm">
                        <div class="mb-3">
                            <label class="form-label">Ay Seçin</label>
                            <input type="month" class="form-control" id="monthlyReportMonth" value="@DateTime.Now.ToString("yyyy-MM")" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Format</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="monthlyFormat" id="monthlyPdf" value="pdf" checked>
                                <label class="btn btn-outline-danger" for="monthlyPdf">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-pdf me-1" viewBox="0 0 16 16">
                                        <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                                    </svg>
                                    PDF
                                </label>

                                <input type="radio" class="btn-check" name="monthlyFormat" id="monthlyExcel" value="excel">
                                <label class="btn btn-outline-success" for="monthlyExcel">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-excel me-1" viewBox="0 0 16 16">
                                        <path d="M5.18 4.616a.5.5 0 0 1 .704.064L8 7.219l2.116-2.54a.5.5 0 1 1 .768.641L8.651 8l2.233 2.68a.5.5 0 0 1-.768.64L8 8.781l-2.116 2.54a.5.5 0 0 1-.768-.641L7.349 8 5.116 5.32a.5.5 0 0 1 .064-.704z"/>
                                        <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                                    </svg>
                                    Excel
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-download me-1" viewBox="0 0 16 16">
                                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                                <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                            </svg>
                            Raporu İndir
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Öğrenci Raporu -->
        <div class="col-12 col-lg-4">
            <div class="card h-100 report-workspace report-student">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-circle me-2" viewBox="0 0 16 16">
                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                        </svg>
                        Öğrenci Raporu
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Öğrenciye ait tüm dersler, ödemeler ve istatistikler</p>

                    <form id="studentReportForm">
                        <div class="mb-3">
                            <label class="form-label">Öğrenci Seçin</label>
                            <select class="form-select" id="studentReportSelect" required>
                                <option value="">Öğrenci seçin...</option>
                                @foreach (var student in students)
                                {
                                    <option value="@student.Id">@student.AdSoyad</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Format</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="studentFormat" id="studentPdf" value="pdf" checked>
                                <label class="btn btn-outline-danger" for="studentPdf">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-pdf me-1" viewBox="0 0 16 16">
                                        <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                                    </svg>
                                    PDF
                                </label>

                                <input type="radio" class="btn-check" name="studentFormat" id="studentExcel" value="excel">
                                <label class="btn btn-outline-success" for="studentExcel">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-excel me-1" viewBox="0 0 16 16">
                                        <path d="M5.18 4.616a.5.5 0 0 1 .704.064L8 7.219l2.116-2.54a.5.5 0 1 1 .768.641L8.651 8l2.233 2.68a.5.5 0 0 1-.768.64L8 8.781l-2.116 2.54a.5.5 0 0 1-.768-.641L7.349 8 5.116 5.32a.5.5 0 0 1 .064-.704z"/>
                                        <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                                    </svg>
                                    Excel
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-download me-1" viewBox="0 0 16 16">
                                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                                <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                            </svg>
                            Raporu İndir
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Gelir Raporu -->
        <div class="col-12 col-lg-4">
            <div class="card h-100 report-workspace report-income">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-cash-stack me-2" viewBox="0 0 16 16">
                            <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
                            <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z"/>
                        </svg>
                        Gelir Raporu
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Aylık gelir detayları (Dersler + Ödemeler)</p>

                    <form id="incomeReportForm">
                        <div class="mb-3">
                            <label class="form-label">Ay Seçin</label>
                            <input type="month" class="form-control" id="incomeReportMonth" value="@DateTime.Now.ToString("yyyy-MM")" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Format</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="incomeFormat" id="incomePdf" value="pdf" checked>
                                <label class="btn btn-outline-danger" for="incomePdf">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-pdf me-1" viewBox="0 0 16 16">
                                        <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                                    </svg>
                                    PDF
                                </label>

                                <input type="radio" class="btn-check" name="incomeFormat" id="incomeExcel" value="excel">
                                <label class="btn btn-outline-success" for="incomeExcel">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-excel me-1" viewBox="0 0 16 16">
                                        <path d="M5.18 4.616a.5.5 0 0 1 .704.064L8 7.219l2.116-2.54a.5.5 0 1 1 .768.641L8.651 8l2.233 2.68a.5.5 0 0 1-.768.64L8 8.781l-2.116 2.54a.5.5 0 0 1-.768-.641L7.349 8 5.116 5.32a.5.5 0 0 1 .064-.704z"/>
                                        <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                                    </svg>
                                    Excel
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-warning w-100">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-download me-1" viewBox="0 0 16 16">
                                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                                <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                            </svg>
                            Raporu İndir
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="alert report-note mt-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-info-circle me-2" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
        </svg>
        <strong>Bilgi:</strong> Raporlar PDF veya Excel formatında indirilir. PDF raporları görsel olarak daha zengindir, Excel raporları ise veri analizi için daha uygundur.
    </div>
</div>

<script>
    // Aylık Ders Raporu
    document.getElementById('monthlyReportForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const monthValue = document.getElementById('monthlyReportMonth').value;
        const [year, month] = monthValue.split('-');
        const format = document.querySelector('input[name="monthlyFormat"]:checked').value;

        window.location.href = `/Reports/MonthlyLessonReport?year=${year}&month=${month}&format=${format}`;
    });

    // Öğrenci Raporu
    document.getElementById('studentReportForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const studentId = document.getElementById('studentReportSelect').value;
        if (!studentId) {
            alert('Lütfen bir öğrenci seçin!');
            return;
        }
        const format = document.querySelector('input[name="studentFormat"]:checked').value;

        window.location.href = `/Reports/StudentReport?studentId=${studentId}&format=${format}`;
    });

    // Gelir Raporu
    document.getElementById('incomeReportForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const monthValue = document.getElementById('incomeReportMonth').value;
        const [year, month] = monthValue.split('-');
        const format = document.querySelector('input[name="incomeFormat"]:checked').value;

        window.location.href = `/Reports/IncomeReport?year=${year}&month=${month}&format=${format}`;
    });
</script>
