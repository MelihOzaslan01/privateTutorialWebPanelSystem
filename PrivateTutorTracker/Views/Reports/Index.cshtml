@using PrivateTutorTracker.Models
@{
    ViewData["Title"] = "Raporlar";
    var students = (List<Student>)ViewBag.Students;
}

<style>
    /* Rapor sayfası mobil optimizasyonu */
    @@media (max-width: 768px) {
        .container-fluid {
            padding-left: 1rem;
            padding-right: 1rem;
        }
        
        .card-body {
            padding: 1.5rem !important;
        }
        
        .card-header h5 {
            font-size: 1rem;
        }
        
        .btn-lg {
            font-size: 1rem;
            padding: 0.75rem 1.5rem;
        }
        
        h4 {
            font-size: 1.25rem;
        }
        
        /* Liste öğeleri */
        .list-unstyled li {
            font-size: 0.9rem;
            line-height: 1.6;
        }
        
        /* Form elemanları */
        .form-control, .form-select {
            font-size: 16px; /* iOS zoom önleme */
        }
        
        /* Butonlar */
        .btn {
            min-height: 44px;
        }
    }
    
    @@media (max-width: 576px) {
        .container-fluid {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }
        
        .card {
            margin-bottom: 1rem;
        }
        
        .card-body {
            padding: 1rem !important;
        }
        
        h2 {
            font-size: 1.5rem;
        }
        
        h4 {
            font-size: 1.1rem;
        }
        
        .btn-lg {
            font-size: 0.95rem;
            padding: 0.65rem 1.25rem;
        }
        
        /* Alert banner */
        .alert h4 {
            font-size: 1.15rem;
        }
        
        .alert p {
            font-size: 0.85rem;
        }
        
        /* Liste öğeleri daha kompakt */
        .list-unstyled li {
            font-size: 0.85rem;
            margin-bottom: 0.5rem !important;
        }
        
        .list-unstyled li svg {
            width: 14px;
            height: 14px;
        }
    }
    
    /* Touch device için optimizasyon */
    @@media (hover: none) and (pointer: coarse) {
        .card {
            transition: none;
        }
        
        .btn {
            min-height: 44px;
            min-width: 44px;
        }
    }

    .report-workspace {
        --report-accent: #5367e9;
        border: 1px solid #e2e6ee;
        border-radius: 8px;
        background: #fff;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(30, 36, 50, .07);
        transition: transform .18s ease, box-shadow .18s ease;
    }
    .report-workspace:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(30, 36, 50, .1);
    }
    .report-workspace.report-student { --report-accent: #27895b; }
    .report-workspace.report-income { --report-accent: #d99718; }
    .report-workspace .card-header {
        padding: 1.15rem 1.25rem .55rem;
        color: #252936 !important;
        background: #fff !important;
        border: 0;
        border-top: 4px solid var(--report-accent);
    }
    .report-workspace .card-header h5 {
        display: flex;
        align-items: center;
        gap: .65rem;
        font-size: 1.05rem;
        font-weight: 700;
    }
    .report-workspace .card-header svg { color: var(--report-accent); }
    .report-workspace .card-body {
        display: flex;
        flex-direction: column;
        padding: .65rem 1.25rem 1.25rem;
    }
    .report-workspace .card-body > p {
        min-height: 44px;
        margin-bottom: 1.25rem;
        font-size: .9rem;
        line-height: 1.5;
    }
    .report-workspace form { display: flex; flex-direction: column; flex: 1; }
    .report-workspace .form-label {
        margin-bottom: .45rem;
        color: #4d5361;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
    }
    .report-workspace .form-control,
    .report-workspace .form-select {
        min-height: 46px;
        border-color: #d9dee8;
        border-radius: 6px;
        background-color: #fafbfc;
    }
    .report-workspace .btn-group {
        padding: 4px;
        border: 1px solid #dfe3eb;
        border-radius: 7px;
        background: #f5f6f8;
        gap: 4px;
    }
    .report-workspace .btn-group .btn {
        border: 0;
        border-radius: 5px !important;
        color: #626978;
        background: transparent;
    }
    .report-workspace .btn-check:checked + .btn {
        color: #262b37;
        background: #fff;
        box-shadow: 0 2px 7px rgba(31, 39, 56, .12);
    }
    .report-workspace form > button {
        min-height: 46px;
        margin-top: auto;
        border: 0;
        border-radius: 6px;
        color: #fff !important;
        background: var(--report-accent) !important;
        font-weight: 700;
    }
    .reports-heading {
        padding: 1.25rem 1.4rem;
        border: 1px solid #e0e4ec;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 5px 18px rgba(30, 36, 50, .05);
    }
    .reports-heading h2 { font-size: 1.7rem; font-weight: 750; }
    .reports-heading .btn { border-radius: 6px; font-size: .9rem; }
    .report-section-title {
        display: flex;
        align-items: center;
        gap: .65rem;
        margin: 2rem 0 1rem !important;
        color: #272b35;
        font-size: 1.15rem;
        font-weight: 700;
    }
    .report-note {
        border: 1px solid #d9e4ea;
        border-left: 4px solid #52a5bc;
        border-radius: 6px;
        color: #42505a;
        background: #f3fafc;
        font-size: .9rem;
    }

    @@media (max-width: 768px) {
        .reports-heading { padding: 1rem; }
        .reports-heading .d-flex.gap-2 { display: grid !important; grid-template-columns: 1fr 1fr; }
        .report-workspace:hover { transform: none; }
        .report-workspace .card-body > p { min-height: auto; }
    }
</style>

<div class="container-fluid reports-page">
    <div class="reports-heading d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div class="flex-grow-1">
            <h2 class="mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-file-earmark-bar-graph me-2 d-none d-sm-inline" viewBox="0 0 16 16">
                    <path d="M10 13.5a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-6a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v6zm-2.5.5a.5.5 0 0 1-.5-.5v-4a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-1zm-3 0a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.5.5h-1z"/>
