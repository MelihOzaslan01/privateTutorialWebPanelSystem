@model LessonTemplate

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Ad" class="form-label">Sablon Adi</label>
        <input asp-for="Ad" class="form-control" />
        <span asp-validation-for="Ad" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Konu" class="form-label">Konu</label>
        <input asp-for="Konu" class="form-control" />
        <span asp-validation-for="Konu" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="VarsayilanSure" class="form-label">Sure</label>
        <input asp-for="VarsayilanSure" class="form-control" />
        <span asp-validation-for="VarsayilanSure" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="VarsayilanUcret" class="form-label">Ucret</label>
        <input asp-for="VarsayilanUcret" class="form-control" />
        <span asp-validation-for="VarsayilanUcret" class="text-danger"></span>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="AktifMi" class="form-check-input" />
            <label asp-for="AktifMi" class="form-check-label">Aktif</label>
        </div>
    </div>
    <div class="col-12">
        <label asp-for="VarsayilanNot" class="form-label">Not</label>
        <textarea asp-for="VarsayilanNot" class="form-control" rows="3"></textarea>
        <span asp-validation-for="VarsayilanNot" class="text-danger"></span>
    </div>
</div>
