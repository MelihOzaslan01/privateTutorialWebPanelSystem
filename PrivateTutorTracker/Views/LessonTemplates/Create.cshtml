@model PrivateTutorTracker.Models.LessonTemplate

@{
    ViewData["Title"] = "Yeni Ders Şablonu";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-layer-group me-2"></i>Yeni Ders Şablonu Oluştur</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Ad" class="form-label"></label>
                            <input asp-for="Ad" class="form-control" placeholder="örn: Matematik Dersi" />
                            <span asp-validation-for="Ad" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Konu" class="form-label"></label>
                            <input asp-for="Konu" class="form-control" placeholder="örn: Türev ve İntegral" />
                            <span asp-validation-for="Konu" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="VarsayilanSure" class="form-label"></label>
                                <input asp-for="VarsayilanSure" class="form-control" type="number" />
                                <span asp-validation-for="VarsayilanSure" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="VarsayilanUcret" class="form-label"></label>
                                <input asp-for="VarsayilanUcret" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="VarsayilanUcret" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VarsayilanNot" class="form-label"></label>
                            <textarea asp-for="VarsayilanNot" class="form-control" rows="3" placeholder="Şablon için varsayılan not (opsiyonel)"></textarea>
                            <span asp-validation-for="VarsayilanNot" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Geri Dön
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-2"></i>Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
